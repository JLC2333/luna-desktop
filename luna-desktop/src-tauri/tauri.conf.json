{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "LunA Forge",
  "version": "1.1.5",
  "identifier": "com.luna.desktop.release",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npx vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LunA Forge",
        "width": 1200,
        "height": 820,
        "minWidth": 700,
        "minHeight": 500,
        "center": true
      }
    ],
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"]
  }
}
