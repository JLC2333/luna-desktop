{
  "compilerOptions": {
    "target": "es6",
    "module": "es2015",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "./dist",
    "removeComments": true,
    "baseUrl": "./",
    "paths": {
      "@framework/*": ["../framework/*"]
    },
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "include": ["./*.ts"],
  "exclude": ["node_modules", "dist"]
}
